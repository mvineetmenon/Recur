# =============================================================================
# Recur environment configuration
# =============================================================================
# Copy this file to `.env` (in the same directory) and adjust:
#
#   cp .env.example .env
#
# The `.env` file is used in BOTH run modes:
#   * Dockerized:  `docker compose` loads it automatically for variable
#     interpolation, and docker-compose.yml forwards the server variables
#     (DATABASE_URL, DEBUG, LOG_LEVEL, CORS_ORIGINS) into the container.
#   * Standalone:  `python -m server.app.main` loads it via python-dotenv
#     (repo-root `.env`, or `.env` in the current working directory).
#
# Variables already set in the real environment ALWAYS take precedence over
# values from `.env`. Format is KEY=value (quotes optional); `#` starts a
# comment. Every variable is optional - the defaults listed below apply when
# a variable is absent.
# =============================================================================

# -----------------------------------------------------------------------------
# Server (standalone and dockerized)
# -----------------------------------------------------------------------------

# SQLAlchemy database URL (standalone mode; in docker mode the connection is
# built by docker-compose.yml from the bundled PostgreSQL service and
# DB_PASSWORD below).
#   standalone default : sqlite:///./recur.db
# Examples:
#   sqlite:////absolute/path/to/recur.db
#   postgresql+psycopg2://recur:secret@db.example.com:5432/recur
#DATABASE_URL=

# "true" enables debug logging and uvicorn auto-reload. Keep "false" in
# production. (Docker mode default: false)
DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Comma-separated list of allowed CORS origins; "*" allows all (dev default).
# Example: CORS_ORIGINS=https://dash.example.com,https://ops.example.com
CORS_ORIGINS=*

# Interface the server binds to. Standalone mode only (in docker mode the
# container always binds 0.0.0.0).
HOST=0.0.0.0

# Port the server listens on. Standalone mode only - in docker mode the
# container always listens on 8000; the host port is RECUR_HTTP_PORT below.
PORT=8000

# -----------------------------------------------------------------------------
# Docker Compose only (host-side ports and the bundled PostgreSQL)
# -----------------------------------------------------------------------------
# These variables are consumed by docker-compose.yml for host port mapping
# and the database password; they are NOT passed into the container.
# (HOST and PORT from the server section are intentionally not used in
# docker mode: the container always listens on 0.0.0.0:8000.)

# Host port the server is published on.
RECUR_HTTP_PORT=8000

# Host port the PostgreSQL container is published on.
PG_HOST_PORT=5432

# Password for the PostgreSQL "recur" user, used by the default DATABASE_URL
# in docker mode. Choose a strong value for anything beyond local dev.
DB_PASSWORD=recur-dev-password

# -----------------------------------------------------------------------------
# Agent (bare-metal hosts running agent/recur-agent.sh)
# -----------------------------------------------------------------------------
# When installed via agent/install.sh, the systemd service reads
# /etc/recur/agent.env (created by the installer; overrides there win over
# the unit's built-in defaults). When running the agent script directly, it
# first loads RECUR_AGENT_ENV_FILE if set, otherwise `./.env` from the
# current working directory, so this same section can be reused there.

# Base URL of the central server (no trailing path).
#RECUR_AGENT_SERVER_URL=http://your-server:8000

# Unique agent identifier (defaults to the machine hostname).
#RECUR_AGENT_ID=agent-01

# YAML configuration file with the systems, tasks, and dependencies to check.
#RECUR_AGENT_CONFIG_FILE=/etc/recur/config.yaml

# Agent log file.
#RECUR_AGENT_LOG_FILE=/var/log/recur-agent.log
